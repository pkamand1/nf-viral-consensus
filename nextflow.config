manifest {
    name            = 'nf-viral-consensus'
    author          = 'Patricia K. Kamanda'
    homePage        = 'https://github.com/pkamand1/nf-viral-consensus'
    description     = 'Reference-based consensus genomes, variant calls, coverage QC, and phylogeny for viral whole-genome sequencing'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    input               = null
    fasta               = "${projectDir}/assets/reference/MN908947.3.fasta"
    gff                 = "${projectDir}/assets/reference/MN908947.3.genes.gff"
    primer_bed          = null
    outdir              = 'results'
    publish_dir_mode    = 'copy'
    help                = false

    min_base_quality    = 20
    min_read_length     = 30
    min_depth           = 10
    min_variant_qual    = 20
    min_genome_fraction = 0.90
    consensus_min_af    = 0.75

    skip_phylogeny      = false
    tree_model          = 'HKY+G'
    tree_bootstrap      = 1000

    single_container    = null
    max_cpus            = 8
    max_memory          = '16.GB'
}

process {
    cpus   = 1
    memory = '2.GB'
    time   = '2.h'

    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143] ? 'retry' : 'finish' }
    maxRetries    = 1

    withLabel: 'process_low'    { cpus = 1; memory = '2.GB' }
    withLabel: 'process_medium' { cpus = { Math.min(4, params.max_cpus as int) }; memory = { [6.GB, params.max_memory as nextflow.util.MemoryUnit].min() } }
    withLabel: 'process_high'   { cpus = { Math.min(8, params.max_cpus as int) }; memory = { params.max_memory as nextflow.util.MemoryUnit } }
}

// Per-tool BioContainers images, pinned to the same bioconda builds as envs/environment.yml.
// Setting --single_container replaces all of them with one image built from containers/.
process {
    withName: 'FASTP'                        { container = params.single_container ?: 'quay.io/biocontainers/fastp:1.4.0--h43da1c4_0' }
    withName: 'BOWTIE2_BUILD|BOWTIE2_ALIGN'  { container = params.single_container ?: 'quay.io/biocontainers/bowtie2:2.5.5--h63e9258_2' }
    withName: 'SAMTOOLS_SORT|SORT_TRIMMED|SAMTOOLS_STATS' { container = params.single_container ?: 'quay.io/biocontainers/samtools:1.24--h9dcdb79_1' }
    withName: 'IVAR_TRIM'                    { container = params.single_container ?: 'quay.io/biocontainers/ivar:1.4.4--h077b44d_0' }
    withName: 'BCFTOOLS_CALL|BCFTOOLS_CONSENSUS' { container = params.single_container ?: 'quay.io/biocontainers/bcftools:1.25--h118bc1c_0' }
    withName: 'MAFFT'                        { container = params.single_container ?: 'quay.io/biocontainers/mafft:7.525--h031d066_0' }
    withName: 'IQTREE'                       { container = params.single_container ?: 'quay.io/biocontainers/iqtree:3.1.4--h8471819_0' }
    withName: 'ANNOTATE_VARIANTS|SUMMARY'    { container = params.single_container ?: 'docker.io/library/python:3.12-slim' }
    withName: 'MULTIQC'                      { container = params.single_container ?: 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2' }
}

profiles {
    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g)'
        singularity.enabled = false
        apptainer.enabled   = false
        conda.enabled       = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        apptainer.enabled      = false
        conda.enabled          = false
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
        singularity.enabled  = false
        conda.enabled        = false
    }
    conda {
        conda.enabled       = true
        conda.useMicromamba = true
        process.conda       = "${projectDir}/envs/environment.yml"
        docker.enabled      = false
        singularity.enabled = false
        apptainer.enabled   = false
    }
    slurm  { process.executor = 'slurm';  executor.queueSize = 50 }
    condor { process.executor = 'condor'; executor.queueSize = 50 }
    test          { includeConfig 'conf/test.config' }
    test_sispa    { includeConfig 'conf/test_sispa.config' }
    test_amplicon { includeConfig 'conf/test_amplicon.config' }
}

timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.txt" }
