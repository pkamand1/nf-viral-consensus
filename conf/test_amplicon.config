// Real SARS-CoV-2 ARTIC V3 amplicon Illumina reads from the nf-core test-datasets repository.
// Requires internet access to raw.githubusercontent.com.
params {
    input      = "${projectDir}/assets/test/samplesheet_amplicon.csv"
    primer_bed = "${projectDir}/assets/reference/nCoV-2019.artic.V3.bed"
    outdir     = 'results_amplicon'
    max_cpus   = 2
    max_memory = '4.GB'
}
