// Real SARS-CoV-2 SISPA (metagenomic) Illumina reads from the nf-core test-datasets repository.
// Requires internet access to raw.githubusercontent.com.
params {
    input      = "${projectDir}/assets/test/samplesheet_sispa.csv"
    outdir     = 'results_sispa'
    max_cpus   = 2
    max_memory = '4.GB'
}
